# Plantilla de configuración de SIGBI. Cópiala como .env y sustituye los valores:
#
#   cp .env.example .env
#
# Este fichero se versiona: TODOS LOS VALORES SON FICTICIOS. El .env queda fuera de git.
# "abcdefghijklmnopqrst" hace de referencia del proyecto de Supabase; cámbiala en todas
# las líneas. El backend lee el .env al arrancar desde la carpeta backend; una variable de
# entorno real con el mismo nombre manda sobre el fichero, igual que la configuración de
# ejecución del IDE.

# ---- Base de datos: Supabase, Session Pooler ----------------------------------
# Project Settings -> Database -> Connection string -> Session pooler
#   - host del pooler (aws-<n>-<region>.pooler.supabase.com), no db.<ref>.supabase.co
#   - puerto 5432 (sesión). El 6543 (transacción) rompe las sentencias preparadas
#   - el usuario lleva la referencia: postgres.<ref>
#   - la cadena empieza por jdbc: aunque Supabase la muestre sin el prefijo
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.abcdefghijklmnopqrst
DB_PASSWORD=contraseña-ficticia-cambiar
# Opcional (5 por defecto): el Session Pooler admite 15 conexiones en total
# DB_POOL_SIZE=5

# ---- Servidor ------------------------------------------------------------------
SERVER_PORT=8080
FRONT_URL=http://localhost:4200

# ---- Autenticación: Supabase Auth ----------------------------------------------
# Project Settings -> API. Las cuatro son obligatorias para arrancar, aunque
# AUTH_ENABLED sea false (en ese caso basta con que tengan cualquier valor).
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ISSUER_URI=https://abcdefghijklmnopqrst.supabase.co/auth/v1
SUPABASE_ANON_KEY=anon-key-ficticia-cambiar
# Clave de servicio: salta el RLS. NUNCA al repositorio.
SUPABASE_SERVICE_ROLE_KEY=service-role-key-ficticia-cambiar

# false: /v1/** abierto sin token (desarrollo). true: exige el JWT de Supabase y
# entonces environment.AUTH_ENABLED del frontend también tiene que ser true.
AUTH_ENABLED=true
# Tiene que decir lo mismo que environment.AUTH_MODE del frontend
AUTH_MODE=bearer

# ---- Asistente de IA (opcional) ------------------------------------------------
# Sin clave el asistente responde que no está configurado; el resto funciona igual.
# Cualquier servicio compatible con la API de OpenAI (URL con /v1 o equivalente) y un
# modelo que admita llamadas a herramientas. Ejemplo con el nivel gratuito de Gemini
# (clave en https://aistudio.google.com/apikey). Sin estas dos líneas: OpenAI y gpt-4o-mini.
OPENAI_API_KEY=clave-ficticia-cambiar
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.5-flash-lite

# ---- Primer administrador ------------------------------------------------------
# Solo se usan si no hay ningún ADMIN habilitado: el arranque crea esa cuenta en
# Supabase Auth y en SIGBI. Si el correo ya existe en Supabase, se vincula y conserva
# su contraseña. Vacías, el arranque solo crea los roles. Contraseña: mínimo 6 caracteres.
BOOTSTRAP_ADMIN_EMAIL=admin@ejemplo.com
BOOTSTRAP_ADMIN_PASSWORD=contraseña-ficticia-cambiar
